:root{
  --yellow:#ffc107; --dark:#1a1f2b; --gray:#5b6472; --light:#f5f7fa;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Segoe UI',Arial,sans-serif;color:var(--dark);line-height:1.6}
.container{max-width:1140px;margin:0 auto;padding:0 20px}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}

.btn{display:inline-block;background:var(--yellow);color:var(--dark);padding:14px 32px;
     border-radius:8px;font-weight:700;font-size:16px;transition:.2s;border:none;cursor:pointer}
.btn:hover{background:#ffb300;transform:translateY(-2px)}
.btn-outline{background:transparent;border:2px solid var(--yellow);color:#fff}
.btn-outline:hover{background:var(--yellow);color:var(--dark)}

/* ШАПКА */
header{background:var(--dark);color:#fff;padding:15px 0;position:sticky;top:0;z-index:100}
.header-inner{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px}
.logo{font-size:24px;font-weight:800;display:flex;align-items:center;gap:8px}
.logo span{color:var(--yellow)}
nav ul{display:flex;list-style:none;gap:25px;flex-wrap:wrap}
nav a{font-size:15px;transition:.2s;padding:5px 0;border-bottom:2px solid transparent}
nav a:hover,nav a.active{color:var(--yellow);border-bottom-color:var(--yellow)}
.phone{font-size:18px;font-weight:700;text-align:right}
.phone small{display:block;font-size:12px;font-weight:400;color:#9aa4b2}

/* ГЕРОЙ */
.hero{background:linear-gradient(135deg,#1a1f2b 0%,#2c3547 100%);color:#fff;padding:70px 0}
.hero h1{font-size:42px;line-height:1.2;margin-bottom:20px}
.hero h1 span{color:var(--yellow)}
.hero p{font-size:18px;color:#c5ccd6;margin-bottom:30px;max-width:600px}
.hero-features{display:flex;gap:35px;margin-top:40px;flex-wrap:wrap}
.hero-features div{display:flex;align-items:center;gap:10px;font-size:15px}
.hero-features b{color:var(--yellow);font-size:22px}

/* СЕКЦИИ */
.section{padding:70px 0}
.section.alt{background:var(--light)}
.section-title{text-align:center;font-size:34px;margin-bottom:15px}
.section-sub{text-align:center;color:var(--gray);margin-bottom:50px;font-size:17px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:25px}

.card{background:var(--light);padding:30px;border-radius:12px;transition:.3s}
.section.alt .card{background:#fff}
.card:hover{transform:translateY(-5px);box-shadow:0 10px 30px rgba(0,0,0,.1)}
.card .icon{font-size:38px;margin-bottom:15px}
.card h3{font-size:20px;margin-bottom:10px}
.card p{color:var(--gray);font-size:15px}

/* УСЛУГИ */
.service-item{background:#fff;padding:25px;border-radius:12px;border-left:4px solid var(--yellow)}
.service-item h3{font-size:19px;margin-bottom:8px}
.service-item p{color:var(--gray);font-size:15px;margin-bottom:12px}
.price{font-weight:800;font-size:18px}

/* ЦИФРЫ */
.stats{background:var(--dark);color:#fff;padding:60px 0}
.stats .grid{text-align:center}
.stats b{display:block;font-size:42px;color:var(--yellow)}
.stats span{color:#c5ccd6}

/* ПОРТФОЛИО */
.work{background:#fff;border-radius:12px;overflow:hidden;transition:.3s;box-shadow:0 2px 12px rgba(0,0,0,.07)}
.work:hover{transform:translateY(-5px);box-shadow:0 12px 30px rgba(0,0,0,.15)}
.work-img{height:200px;background:linear-gradient(135deg,#2c3547,#1a1f2b);
          display:flex;align-items:center;justify-content:center;font-size:60px}
.work-body{padding:22px}
.work-body h3{font-size:18px;margin-bottom:8px}
.work-body p{color:var(--gray);font-size:14px}
.work-tag{display:inline-block;background:#fff3cd;color:#8a6d00;font-size:12px;
          padding:4px 10px;border-radius:20px;margin-top:12px;font-weight:600}

/* КОМАНДА */
.team-card{background:#fff;padding:25px;border-radius:12px;text-align:center;
           box-shadow:0 2px 12px rgba(0,0,0,.07)}
.avatar{width:90px;height:90px;border-radius:50%;background:var(--dark);color:var(--yellow);
        display:flex;align-items:center;justify-content:center;font-size:36px;
        margin:0 auto 15px;font-weight:800}
.team-card h3{font-size:18px;margin-bottom:4px}
.team-card span{color:var(--gray);font-size:14px}

/* ФОРМА */
.form-wrap{max-width:600px;margin:0 auto;background:var(--light);padding:40px;border-radius:16px}
.section.alt .form-wrap{background:#fff}
.form-wrap input,.form-wrap textarea{width:100%;padding:15px;margin-bottom:15px;
     border:1px solid #dde3ea;border-radius:8px;font-size:16px;font-family:inherit}
.form-wrap input:focus,.form-wrap textarea:focus{outline:2px solid var(--yellow);border-color:transparent}
.form-wrap .btn{width:100%}
.form-note{font-size:13px;color:var(--gray);text-align:center;margin-top:12px}

/* КОНТАКТЫ */
.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px}
.contact-item{display:flex;gap:15px;margin-bottom:25px}
.contact-item .ci{font-size:28px}
.contact-item h3{font-size:16px;margin-bottom:3px}
.contact-item p{color:var(--gray);font-size:15px}
.contact-item a:hover{color:var(--yellow)}

/* КАРТА */
.map{margin-top:30px;border-radius:12px;overflow:hidden;height:350px;background:#e8ecf1;
     display:flex;align-items:center;justify-content:center;color:var(--gray)}

/* ХЛЕБНЫЕ КРОШКИ */
.breadcrumbs{padding:20px 0;font-size:14px;color:var(--gray)}
.breadcrumbs a:hover{color:var(--yellow)}

/* ФУТЕР */
footer{background:var(--dark);color:#9aa4b2;padding:45px 0;font-size:14px}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:30px;margin-bottom:30px}
footer .logo{justify-content:flex-start;margin-bottom:15px;color:#fff;font-size:22px}
footer h4{color:#fff;font-size:16px;margin-bottom:12px}
footer a:hover{color:var(--yellow)}
footer ul{list-style:none}
footer ul li{margin-bottom:8px}
.footer-bottom{border-top:1px solid #2c3547;padding-top:20px;text-align:center}

@media(max-width:768px){
  .hero h1{font-size:30px}
  .section-title{font-size:26px}
  .hero{padding:50px 0}
  .contact-grid,.footer-grid{grid-template-columns:1fr}
  nav ul{gap:15px;font-size:14px}
}
